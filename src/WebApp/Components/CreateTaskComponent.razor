@using System.Text.Json
@using System.Text.RegularExpressions
@using Fistix.TaskManager.ViewModel.Commands.Todos
@using Fistix.TaskManager.ViewModel.Validators.Todos
@using Fistix.TaskManager.WebApp.Services.DataServices
@using FluentValidation
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject TodoDataService TodoDataService

<MudPaper Class="pa-4" Elevation="2">
  <MudText Typo="Typo.h6" Class="mb-4">Create New Task</MudText>

  <EditForm Model="@Command" OnSubmit="HandleSubmit">
    <MudStack Spacing="3">
      <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudButton Variant="@(_recording ? Variant.Filled : Variant.Outlined)"
                   Color="@(_recording ? Color.Error : Color.Secondary)"
                   Disabled="@_voiceBusy"
                   OnClick="ToggleRecordingAsync"
                   StartIcon="@(_recording ? Icons.Material.Filled.Stop : Icons.Material.Filled.Mic)">
          @(_voiceBusy ? "Processing..." : (_recording ? "Stop" : "Dictate"))
        </MudButton>
        @if (_voiceBusy)
        {
          <MudProgressCircular Size="Size.Small" Indeterminate="true" />
          <MudText Typo="Typo.caption">@_voiceStatus</MudText>
        }
      </MudStack>

      @if (!string.IsNullOrWhiteSpace(_voiceError))
      {
        <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true">@_voiceError</MudAlert>
      }

      @if (!string.IsNullOrWhiteSpace(_lastTranscript))
      {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Heard: @_lastTranscript</MudText>
      }

      <MudTextField @bind-Value="Command.Title"
                    Label="Title"
                    Variant="Variant.Outlined"
                    Required="true"
                    Error="@HasError(nameof(CreateTodoTaskCommand.Title))"
                    ErrorText="@GetError(nameof(CreateTodoTaskCommand.Title))" />

      <MudTextField @bind-Value="Command.Description"
                    Label="Description"
                    Variant="Variant.Outlined"
                    Lines="3"
                    Error="@HasError(nameof(CreateTodoTaskCommand.Description))"
                    ErrorText="@GetError(nameof(CreateTodoTaskCommand.Description))" />

      <MudDatePicker Date="_dueDate"
                     DateChanged="OnDueDateChanged"
                     Label="Due Date"
                     Variant="Variant.Outlined"
                     Error="@HasError(nameof(CreateTodoTaskCommand.DueDate))"
                     ErrorText="@GetError(nameof(CreateTodoTaskCommand.DueDate))" />

      <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Create task</MudButton>
    </MudStack>
  </EditForm>
</MudPaper>

@code {
  private const string CreateTodoToolName = "create_todo";

  [Inject]
  private IValidator<CreateTodoTaskCommand> Validator { get; set; } = default!;

  private CreateTodoTaskCommand Command { get; set; } = new();
  private DateTime? _dueDate = DateTime.Today.AddDays(1);
  private Dictionary<string, string> _errors = new();
  private bool _recording;
  private bool _voiceBusy;
  private string? _voiceError;
  private string? _voiceStatus;
  private string? _lastTranscript;

  [Parameter]
  public EventCallback OnSubmitForm { get; set; }

  private bool HasError(string field) => _errors.ContainsKey(field);

  private string GetError(string field) =>
    _errors.TryGetValue(field, out var message) ? message : string.Empty;

  private async Task HandleSubmit()
  {
    _errors.Clear();
    if (_dueDate.HasValue)
    {
      Command.DueDate = _dueDate.Value;
    }

    var result = await Validator.ValidateAsync(Command);
    if (!result.IsValid)
    {
      foreach (var failure in result.Errors)
      {
        _errors[failure.PropertyName] = failure.ErrorMessage;
      }

      return;
    }

    await OnSubmitForm.InvokeAsync(Command);
    Command = new CreateTodoTaskCommand();
    _dueDate = DateTime.Today.AddDays(1);
    _lastTranscript = null;
    _voiceError = null;
  }

  private void OnDueDateChanged(DateTime? date) => _dueDate = date;

  private async Task ToggleRecordingAsync()
  {
    if (_voiceBusy)
    {
      return;
    }

    _voiceError = null;

    try
    {
      var supported = await Js.InvokeAsync<bool>("voiceInterop.isSupported");
      if (!supported)
      {
        _voiceError = "Microphone recording is not supported in this browser.";
        return;
      }

      if (!_recording)
      {
        await Js.InvokeVoidAsync("voiceInterop.startRecording");
        _recording = true;
        _voiceStatus = "Listening…";
        return;
      }

      _voiceBusy = true;
      _voiceStatus = "Transcribing…";
      _recording = false;
      // Render disabled button + loader before starting slow transcription work.
      await InvokeAsync(StateHasChanged);

      var recording = await Js.InvokeAsync<VoiceRecordingDto>("voiceInterop.stopRecording");
      if (recording is null || string.IsNullOrWhiteSpace(recording.Base64))
      {
        _voiceError = "No audio was captured.";
        return;
      }

      var bytes = Convert.FromBase64String(recording.Base64);
      await using var stream = new MemoryStream(bytes);
      var transcribe = await TodoDataService.TranscribeAudio(
        stream,
        string.IsNullOrWhiteSpace(recording.FileName) ? "recording.webm" : recording.FileName,
        string.IsNullOrWhiteSpace(recording.ContentType) ? "audio/webm" : recording.ContentType);

      if (!transcribe.IsSucceed || transcribe.Payload is null ||
          string.IsNullOrWhiteSpace(transcribe.Payload.Transcript))
      {
        _voiceError = transcribe.Message ?? "Transcription failed.";
        return;
      }

      var transcript = transcribe.Payload.Transcript.Trim();
      _lastTranscript = transcript;
      _voiceStatus = "Structuring task…";

      await PrefillFromTranscriptAsync(transcript);
    }
    catch (JSException ex)
    {
      _voiceError = ex.Message;
      _recording = false;
      try { await Js.InvokeVoidAsync("voiceInterop.cancelRecording"); } catch { /* ignore */ }
    }
    catch (Exception ex)
    {
      _voiceError = ex.Message;
      _recording = false;
      try { await Js.InvokeVoidAsync("voiceInterop.cancelRecording"); } catch { /* ignore */ }
    }
    finally
    {
      _voiceBusy = false;
      _voiceStatus = null;
    }
  }

  private async Task PrefillFromTranscriptAsync(string transcript)
  {
    var transcriptDueDate = TryResolveFutureDueDate(transcript, out var inferredDueDate)
      ? inferredDueDate
      : (DateTime?)null;

    var proposal = await TodoDataService.ProposeAiTools(transcript);
    if (proposal.IsSucceed && proposal.Payload?.ProposedCalls is { Count: > 0 })
    {
      var createCall = proposal.Payload.ProposedCalls
        .FirstOrDefault(c => string.Equals(c.ToolName, CreateTodoToolName, StringComparison.OrdinalIgnoreCase));

      if (createCall is not null && TryApplyCreateTodoArgs(createCall.Arguments, transcriptDueDate))
      {
        return;
      }
    }

    ApplyTranscriptFallback(transcript, transcriptDueDate);
  }

  private bool TryApplyCreateTodoArgs(Dictionary<string, JsonElement> args, DateTime? fallbackDueDate)
  {
    if (!TryGetStringArg(args, "title", out var title) || string.IsNullOrWhiteSpace(title))
    {
      return false;
    }

    Command.Title = Truncate(title.Trim(), TodoFieldLimits.TitleMaxLength);

    if (TryGetStringArg(args, "description", out var description) && !string.IsNullOrWhiteSpace(description))
    {
      Command.Description = Truncate(description.Trim(), TodoFieldLimits.DescriptionMaxLength);
    }
    else if (string.IsNullOrWhiteSpace(Command.Description))
    {
      Command.Description = Command.Title;
    }

    if (TryGetStringArg(args, "dueDate", out var dueRaw) &&
        TryResolveFutureDueDate(dueRaw, out var dueDate))
    {
      _dueDate = dueDate.Date;
      Command.DueDate = dueDate.Date;
    }
    else if (fallbackDueDate.HasValue)
    {
      _dueDate = fallbackDueDate.Value.Date;
      Command.DueDate = fallbackDueDate.Value.Date;
    }

    return true;
  }

  private void ApplyTranscriptFallback(string transcript, DateTime? inferredDueDate)
  {
    Command.Title = Truncate(transcript, TodoFieldLimits.TitleMaxLength);
    if (string.IsNullOrWhiteSpace(Command.Description))
    {
      Command.Description = Truncate(transcript, TodoFieldLimits.DescriptionMaxLength);
    }

    if (inferredDueDate.HasValue)
    {
      _dueDate = inferredDueDate.Value.Date;
      Command.DueDate = inferredDueDate.Value.Date;
    }
  }

  private static bool TryGetStringArg(Dictionary<string, JsonElement> args, string key, out string value)
  {
    value = string.Empty;
    if (!args.TryGetValue(key, out var element))
    {
      var match = args.FirstOrDefault(kv =>
        string.Equals(kv.Key, key, StringComparison.OrdinalIgnoreCase));
      if (match.Key is null)
      {
        return false;
      }

      element = match.Value;
    }

    value = element.ValueKind switch
    {
      JsonValueKind.String => element.GetString() ?? string.Empty,
      JsonValueKind.Number => element.ToString(),
      _ => element.ToString()
    };
    return !string.IsNullOrWhiteSpace(value);
  }

  private static string Truncate(string value, int maxLength) =>
    value.Length <= maxLength ? value : value[..maxLength];

  private static bool TryResolveFutureDueDate(string raw, out DateTime dueDate)
  {
    dueDate = default;
    if (string.IsNullOrWhiteSpace(raw))
    {
      return false;
    }

    var value = raw.Trim();
    if (TryResolveRelativeDay(value, out var relativeDate))
    {
      dueDate = relativeDate;
      return true;
    }

    if (TryParseDayOfWeek(value, out var dayOfWeek))
    {
      dueDate = NextOccurrenceOfDay(dayOfWeek);
      return true;
    }

    if (!DateTime.TryParse(value, out var parsed))
    {
      return false;
    }

    // If the parser resolves relative weekday text to a past day, push to next week.
    if (parsed <= DateTime.Now && !value.Any(char.IsDigit) && TryParseDayOfWeek(value, out dayOfWeek))
    {
      dueDate = NextOccurrenceOfDay(dayOfWeek);
      return true;
    }

    if (parsed <= DateTime.Now)
    {
      return false;
    }

    dueDate = parsed;
    return true;
  }

  private static bool TryResolveRelativeDay(string input, out DateTime dueDate)
  {
    dueDate = default;
    var normalized = input.Trim().ToLowerInvariant();

    if (normalized.Contains("tomorrow", StringComparison.Ordinal))
    {
      dueDate = DateTime.Today.AddDays(1);
      return true;
    }

    if (normalized.Contains("day after tomorrow", StringComparison.Ordinal))
    {
      dueDate = DateTime.Today.AddDays(2);
      return true;
    }

    if (normalized.Contains("next week", StringComparison.Ordinal))
    {
      dueDate = DateTime.Today.AddDays(7);
      return true;
    }

    return false;
  }

  private static bool TryParseDayOfWeek(string input, out DayOfWeek dayOfWeek)
  {
    var normalized = input.Trim().ToLowerInvariant();
    if (ContainsWord(normalized, "monday") || ContainsWord(normalized, "mon"))
      return MatchDay(DayOfWeek.Monday, out dayOfWeek);
    if (ContainsWord(normalized, "tuesday") || ContainsWord(normalized, "tue") || ContainsWord(normalized, "tues"))
      return MatchDay(DayOfWeek.Tuesday, out dayOfWeek);
    if (ContainsWord(normalized, "wednesday") || ContainsWord(normalized, "wed"))
      return MatchDay(DayOfWeek.Wednesday, out dayOfWeek);
    if (ContainsWord(normalized, "thursday") || ContainsWord(normalized, "thu") || ContainsWord(normalized, "thurs"))
      return MatchDay(DayOfWeek.Thursday, out dayOfWeek);
    if (ContainsWord(normalized, "friday") || ContainsWord(normalized, "fri"))
      return MatchDay(DayOfWeek.Friday, out dayOfWeek);
    if (ContainsWord(normalized, "saturday") || ContainsWord(normalized, "sat"))
      return MatchDay(DayOfWeek.Saturday, out dayOfWeek);
    if (ContainsWord(normalized, "sunday") || ContainsWord(normalized, "sun"))
      return MatchDay(DayOfWeek.Sunday, out dayOfWeek);

    return MatchDay(default, out dayOfWeek, false);
  }

  private static bool MatchDay(DayOfWeek value, out DayOfWeek dayOfWeek, bool result = true)
  {
    dayOfWeek = value;
    return result;
  }

  private static DateTime NextOccurrenceOfDay(DayOfWeek targetDay)
  {
    var today = DateTime.Today;
    var daysAhead = ((int)targetDay - (int)today.DayOfWeek + 7) % 7;
    if (daysAhead == 0)
    {
      daysAhead = 7;
    }

    return today.AddDays(daysAhead);
  }

  private static bool ContainsWord(string source, string word) =>
    Regex.IsMatch(source, $@"\b{Regex.Escape(word)}\b", RegexOptions.IgnoreCase);

  private sealed class VoiceRecordingDto
  {
    [System.Text.Json.Serialization.JsonPropertyName("base64")]
    public string Base64 { get; set; } = string.Empty;

    [System.Text.Json.Serialization.JsonPropertyName("contentType")]
    public string ContentType { get; set; } = "audio/webm";

    [System.Text.Json.Serialization.JsonPropertyName("fileName")]
    public string FileName { get; set; } = "recording.webm";
  }
}
