{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "MainDb": ""
  },
  "App": {
    "CorsOrigins": "https://localhost:5002",
    "DefaultCorsPolicyName": "localhost",
    "ApiAccessKey": ""
  },
  "Auth0": {
    "Authority": "https://dev-ei3inkkfh8w78omw.us.auth0.com/",
    "Audience": "https://api.taskmanager.com/",
    "AuthClientId": "sm6g28P4R1GTrOPpyl0RQhcCIJXgwTuu"
  },
  "Swagger": {
    "ApiVersion": "V1",
    "Title": "Task Manager Api"
  },
  "Azure": {
    "AzureStorageConnectionString": "DefaultEndpointsProtocol=https;AccountName=imagestore;AccountKey=",
    "AzureStorageAccountName": "imagestore",
    "AzureStorageAccountKey": "",
    "ImageContainer": "images"
  },
  "Ai": {
    "Provider": "ollama",
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-4o-mini",
      "Endpoint": "https://api.openai.com/v1"
    },
    "AzureOpenAI": {
      "ApiKey": "",
      "Endpoint": "",
      "Model": "gpt-4"
    },
    "GoogleAI": {
      "ApiKey": "",
      "Model": "gemini-3.1-flash-lite",
      "ApiVersion": "V1_Beta",
      "FallbackModels": [ "gemini-2.5-flash", "gemini-3.5-flash" ]
    },
    "Agents": {
      "ChatModel": "qwen2.5:7b-instruct",
      "StuckAfterSeconds": 300,
      "MaxToolInvocationsPerJob": 12,
      "MaxPlannerRecoveryPasses": 1,
      "JobTimeoutSeconds": 240
    },
    "Observability": {
      "Enabled": true,
      "CapturePayloadPreview": false,
      "PayloadPreviewMaxChars": 256,
      "RecordTokenUsage": true
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "qwen2.5:7b-instruct"
    },
    "Claude": {
      "ApiKey": "",
      "Model": "claude-3-5-sonnet-latest"
    },
    "Embedding": {
      "Provider": "Onnx",
      "Model": "bge-small-en-v1.5",
      "Dimension": 384,
      // "ApiKey": "",
      // "Endpoint": "https://api.openai.com/v1",
      "Onnx": {
        "ModelDirectory": "models/bge-small-en-v1.5",
        "MaxSequenceLength": 512,
        "QueryInstruction": "Represent this sentence for searching: "
      }
    },
    "Features": {
      "EnableSummarization": true,
      "SummarizeRateLimit": {
        "Enabled": true,
        "PermitLimit": 1,
        "WindowMinutes": 1
      },
      "EnableClassification": true,
      "ClassifyRateLimit": {
        "Enabled": true,
        "PermitLimit": 5,
        "WindowMinutes": 1
      },
      "Classification": {
        "RequestTimeoutMs": 90000,//15000,
        "MaxRetries": 1,
        "RetryDelayMs": 500,
        "MaxDegreeOfParallelism": 3
      },
      "EnableEmbeddings": true,
      "EnableSemanticSearch": true,
      "SemanticSearch": {
        "MinSimilarity": 0.45,
        "HybridEnabled": true,
        "VectorCandidateLimit": 40,
        "LexicalCandidateLimit": 40,
        "RrfK": 60
      },
      "SemanticSearchRateLimit": {
        "Enabled": true,
        "PermitLimit": 10,
        "WindowMinutes": 1
      },
      "EnableRag": true,
      "RagRateLimit": {
        "Enabled": true,
        "PermitLimit": 5,
        "WindowMinutes": 1
      },
      "EnableFunctionCalling": true,
      "FunctionCallingRateLimit": {
        "Enabled": true,
        "PermitLimit": 5,
        "WindowMinutes": 1
      },
      "EnableAgents": true,
      "AgentsRateLimit": {
        "Enabled": true,
        "PermitLimit": 3,
        "WindowMinutes": 1
      },
      "EnableMcp": true,
      "Batch": {
        "StuckAfterSeconds": 120,
        "ItemTimeoutMs": 90000,
        "DefaultBatchSize": 5,
        "DefaultDelayMsBetweenItems": 500
      }
    }
  }
}